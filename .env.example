# Google News RSS is the default: free, no API key required.
# Finnhub is retained as an optional adapter; it is not called automatically.
# FINNHUB_API_KEY=
# false enables explicitly labelled demo data; true uses real providers.
REAL_DATA=true

# Pause automatic news while other real data is verified.
NEWS_ENABLED=false

# SEC is free; set a real contact email in local/hosting settings, never commit it.
# SEC_USER_AGENT=US-stock-analyzer your-real-contact-email
